cc_binary {
    name: "scalerd",
    vendor: true,
    srcs: ["scalerd.c"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
    ],
}
